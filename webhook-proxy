from http.server import BaseHTTPRequestHandler
import json, os, time, requests

def simple_hash(s):
    h = 0
    for ch in s:
        h = (h * 31 + ord(ch)) & 0xFFFFFFFF
    return h

class handler(BaseHTTPRequestHandler):
    def _json(self, code, data):
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(json.dumps(data).encode())

    def do_GET(self):
        self._json(200, {"status": "alive"})

    def do_POST(self):
        length = int(self.headers.get("Content-Length", 0))
        body = self.rfile.read(length).decode("utf-8")
        ts   = self.headers.get("X-Timestamp")
        sig  = self.headers.get("X-Signature")
        if not (body and ts and sig):
            return self._json(400, {"error": "missing"})
        try:
            if abs(int(time.time()) - int(ts)) > 150:
                return self._json(403, {"error": "expired"})
        except ValueError:
            return self._json(400, {"error": "bad timestamp"})
        secret = os.environ["WEBHOOK_SECRET"]
        if sig != "%08x" % simple_hash(secret + ts + body):
            return self._json(403, {"error": "bad signature"})
        try:
            payload = json.loads(body)
        except json.JSONDecodeError:
            return self._json(400, {"error": "bad json"})
        try:
            requests.post(os.environ["DISCORD_WEBHOOK"], json=payload, timeout=10)
        except Exception as e:
            return self._json(500, {"error": str(e)})
        return self._json(200, {"status": "ok"})
